# ────── 依存パッケージ ──────
node_modules/

# ────── 環境変数（秘密情報!絶対にコミットしない） ──────
.env
.env.local
.env.*.local

# ────── ユーザーデータ（顧客情報・シフトデータ） ──────
data/*.json
data/shops/

# .gitkeep は残してフォルダ構造を保持
!data/.gitkeep

# ────── ログ ──────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ────── macOS ──────
.DS_Store
.AppleDouble
.LSOverride

# ────── エディタ ──────
.vscode/
.idea/
*.swp
*.swo
*~

# ────── Claude Code ローカル設定 ──────
.claude/launch.json
.claude/settings.local.json

# ────── ビルド成果物 ──────
dist/
build/
.cache/
.next/
.nuxt/
