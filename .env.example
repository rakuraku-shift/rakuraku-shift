# ─────────────────────────────────────
#  BAR EXCHANGE 環境変数
#  このファイルを .env にコピーして使用してください
#  cp .env.example .env
# ─────────────────────────────────────

# サーバーポート（デフォルト: 3000）
PORT=3000

# 外部公開URL（Stripeの決済完了後リダイレクト先に使用）
# 本番環境: https://yourdomain.com
# ローカルテスト (stripe listen --forward-to): http://localhost:3000
BASE_URL=http://localhost:3000

# ─── Stripe ───────────────────────────
# Stripeダッシュボード → 開発者 → APIキー
# テスト用: sk_test_... / 本番用: sk_live_...
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Stripeダッシュボード → 開発者 → APIキー → 公開可能キー
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Webhookシークレット
# stripe listen --forward-to localhost:3000/webhook/stripe
# で表示される whsec_... をここに貼り付け
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# ─── RAKURAKU サブスクリプション Price ID ─────
# Stripeダッシュボード → 商品カタログ → 商品を作成
# 「RAKURAKU スタンダード ¥9,800/月」「RAKURAKU スタンダード ¥98,000/年」を作成し、
# それぞれの Price ID (price_xxx) をここに設定
STRIPE_PRICE_ID_MONTHLY=price_YOUR_MONTHLY_PRICE_ID
STRIPE_PRICE_ID_ANNUAL=price_YOUR_ANNUAL_PRICE_ID

# ライセンスコード生成用のシークレット（任意の長いランダム文字列）
# 例: openssl rand -hex 32 で生成
LICENSE_SECRET=change-me-to-a-random-long-string

# ─── メール通知（スタッフへの勤務要請送信） ────────────
# Gmailの場合: Googleアカウント → セキュリティ → アプリパスワードを発行
# SMTP_HOSTを省略するとGmail (smtp.gmail.com:587) が使われます
EMAIL_USER=yourname@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
